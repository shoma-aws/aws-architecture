import boto3
import json
from datetime import datetime, timedelta

# =========================
# AWSサービスへ接続（＝リモコンを作る）
# =========================

# CloudWatch Logs（ログを取得するためのクライアント）
logs_client = boto3.client('logs')

# CloudWatch Metrics（CPUなどのメトリクス取得）
cloudwatch = boto3.client('cloudwatch')

# CloudTrail（操作履歴取得）
cloudtrail = boto3.client('cloudtrail')

# Bedrock（AIを使うためのクライアント）
bedrock = boto3.client('bedrock-runtime')


def lambda_handler(event, context):

    # =========================
    # ① CloudWatch Logs取得
    # =========================

    # ロググループ名を指定（どのログを見るか）
    log_group_name = "access.log"

    # CloudWatch LogsのAPIを使ってログを取得
    logs_response = logs_client.filter_log_events(
        logGroupName=log_group_name,
        limit=5  # 最新5件だけ取る
    )

    # logs_responseは複雑な構造なので、
    # message（ログ本文）だけ取り出してシンプルなリストにする
    log_messages = [
        log['message']
        for log in logs_response.get('events', [])
    ]


    # =========================
    # ② CPUメトリクス取得
    # =========================

    # 現在時刻（UTC）を取得
    now = datetime.utcnow()

    # 10分前の時刻を作成
    start_time = now - timedelta(minutes=10)

    # CloudWatch Metrics APIでCPU使用率を取得
    metrics_response = cloudwatch.get_metric_statistics(
        Namespace='AWS/EC2',              # EC2のメトリクス
        MetricName='CPUUtilization',      # CPU使用率
        Dimensions=[
            {
                'Name': 'InstanceId',
                'Value': 'i-03cb6ec9f34bce73d'
            },
        ],
        StartTime=start_time,             # 10分前
        EndTime=now,                      # 現在
        Period=300,                       # 5分単位
        Statistics=['Average']            # 平均値
    )

    # Datapointsはリスト形式なので、そのまま取得
    cpu = metrics_response.get('Datapoints', [])


    # =========================
    # ③ CloudTrail（操作履歴取得）
    # =========================

    # 操作履歴を広く取得（原因を決め打ちしない）
    trail_response = cloudtrail.lookup_events(
        MaxResults=20
    )

    # Events（実際の操作履歴）だけ取り出す
    events = trail_response.get('Events', [])

    # AIに渡しやすくするための空リスト
    event_list = []

    # 操作履歴を1個ずつ処理
    for event_item in events:

        # 必要な情報だけ取り出して整形
        event_list.append({
            "event_name": event_item.get('EventName', '不明'),
            "time": str(event_item.get('EventTime', '不明'))
        })


    # =========================
    # ④ 分析データまとめ（構造データ）
    # =========================

    # ここでは「データとしてまとめている」
    # まだAIには渡していない
    analysis_input = {
        "cpu": cpu,
        "logs": log_messages,
        "events": event_list
    }


    # =========================
    # ⑤ AIに渡す文章作成
    # =========================

    # PythonのデータをJSON文字列に変換する
    # default=str を指定することで、
    # datetimeなどJSONに直接変換できない値も文字列にできる
    analysis_data_json = json.dumps(
        analysis_input,
        ensure_ascii=False,
        default=str,
        indent=2
    )

    # AIに分析してもらう指示文を作成
    analysis_text = f"""
以下のAWSシステム情報を分析してください。

【分析対象データ】
{analysis_data_json}

【確認してほしい内容】
・CPU使用率に異常がないか
・アクセスログに問題がないか
・CloudTrailの操作履歴に異常な変更がないか
・障害や性能低下につながる可能性があるか

【出力形式】
・原因
・状態（正常 / 注意 / 異常）
・推奨対応

専門用語を使いすぎず、日本語で分かりやすく回答してください。
"""


    # =========================
    # ⑥ BedrockでAI実行
    # =========================

    # Bedrockへ送信するリクエスト内容を
    # Pythonの辞書として作成する
    request_body = {
        "anthropic_version": "bedrock-2023-05-31",
        "max_tokens": 500,
        "messages": [
            {
                "role": "user",
                "content": [
                    {
                        "type": "text",
                        "text": analysis_text
                    }
                ]
            }
        ]
    }

    # invoke_model = AIにリクエストを送る
    # json.dumpsを使うことで、
    # ログ内の改行やダブルクォーテーションがあっても
    # 正しいJSON形式で送信できる
    response = bedrock.invoke_model(
        modelId="global.anthropic.claude-sonnet-4-5-20250929-v1:0",
        contentType="application/json",
        accept="application/json",
        body=json.dumps(
            request_body,
            ensure_ascii=False
        )
    )


    # =========================
    # ⑦ AIの結果を取得
    # =========================

    # AIのレスポンスはJSON形式（文字）なのでPythonに変換
    response_body = json.loads(
        response['body'].read().decode('utf-8')
    )

    # content → 配列 → 1個目 → text を取り出す
    # = AIの答えだけ抜き出す
    result = response_body['content'][0]['text']


    # =========================
    # ⑧ 結果をログに出力（確認用）
    # =========================

    print("===== Logs =====")
    for msg in log_messages:
        print(msg)

    print("===== CPU =====")
    print(cpu)

    print("===== Events =====")
    for ev in event_list:
        print(ev)

    print("===== AI分析結果 =====")
    print(result)


    return {
        'statusCode': 200,
        'body': json.dumps(
            {
                'message': 'AI分析が完了しました',
                'result': result
            },
            ensure_ascii=False
        )
    }
